# Copia este archivo como .env y ajusta los valores 
# Si no existe .env, docker-compose usa los valores por defecto (solo desarrollo).

DB_USER=marketplace
DB_PASSWORD=marketplace

# Secreto JWT en Base64 (mínimo 256 bits). Genera uno nuevo para cualquier ambiente real:
#   PowerShell: [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   Linux/Mac:  openssl rand -base64 48
JWT_SECRET=M8QzToeO4nTDR7Qa/P8WjS2+IvcRvwvju5DxbONWfIb6rXpC8VRJFahwqyrsOR7B

# Datos de demostración: quitar ",classpath:db/demo" en producción
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/demo

# Simulaciones del caso de uso
PAYMENT_FAILURE_RATE=0.3
ERP_LATENCY=PT1S

# true = omite las pruebas al construir la imagen
SKIP_TESTS=false

SWAGGER_ENABLED=true